<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Sign Up Free — Kievora</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --p:#7c3aed;--p2:#a855f7;--p3:#ede9fe;--p4:#f5f3ff;
  --text:#111827;--sub:#6b7280;--border:#e5e7eb;--white:#fff;
}
body{font-family:'Inter',sans-serif;color:var(--text);background:var(--p4);min-height:100vh;overflow-x:hidden}

/* ── NAV ── */
nav{
  position:sticky;top:0;z-index:200;
  background:rgba(255,255,255,.94);backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);height:64px;
  display:flex;align-items:center;padding:0 40px;justify-content:space-between;
}
.logo{display:flex;align-items:center;gap:8px;text-decoration:none}
.logo-icon{width:34px;height:34px;border-radius:8px;overflow:hidden;flex-shrink:0}
.logo-icon img{width:100%;height:100%;object-fit:cover;display:block}
.logo-name{font-size:17px;font-weight:800;color:var(--text);letter-spacing:-.3px}
.logo-name span{color:var(--p)}
.nav-right{display:flex;gap:8px;align-items:center}
.btn-outline{padding:8px 18px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-weight:600;color:var(--text);text-decoration:none;background:var(--white);transition:all .2s}
.btn-outline:hover{border-color:var(--p);color:var(--p)}
@media(max-width:768px){nav{padding:0 20px}}

/* ── PAGE ── */
.page{min-height:calc(100vh - 64px);display:flex;align-items:stretch}

/* ── LEFT ── */
.left{
  flex:1;
  background:linear-gradient(145deg,var(--p4) 0%,var(--p3) 55%,#ddd6fe 100%);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:60px 48px;position:relative;overflow:hidden;
}
.orb{position:absolute;border-radius:50%;pointer-events:none}
.orb1{width:340px;height:340px;background:radial-gradient(circle,rgba(124,58,237,.12),transparent 70%);top:-80px;right:-80px}
.orb2{width:260px;height:260px;background:radial-gradient(circle,rgba(168,85,247,.10),transparent 70%);bottom:-50px;left:-50px}
.left-inner{position:relative;z-index:1;text-align:center;max-width:380px}
.left-badge{display:inline-flex;align-items:center;gap:6px;background:var(--white);border:1px solid var(--border);border-radius:99px;padding:5px 14px 5px 8px;font-size:12px;font-weight:600;color:var(--sub);margin-bottom:28px;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.left-badge-dot{width:8px;height:8px;border-radius:50%;background:#22c55e;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.left h2{font-size:30px;font-weight:900;letter-spacing:-1px;line-height:1.2;color:var(--text);margin-bottom:14px}
.left h2 span{background:linear-gradient(135deg,var(--p),var(--p2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.left p{font-size:15px;color:var(--sub);line-height:1.7;margin-bottom:32px}

/* Feature checklist */
.features{list-style:none;text-align:left;margin-bottom:32px}
.features li{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;color:var(--text);padding:9px 0;border-bottom:1px solid rgba(124,58,237,.08)}
.features li:last-child{border-bottom:none}
.feat-check{width:22px;height:22px;border-radius:6px;background:linear-gradient(135deg,var(--p),var(--p2));display:flex;align-items:center;justify-content:center;flex-shrink:0}

.trust{display:flex;align-items:center;gap:8px;justify-content:center;font-size:12px;color:var(--sub);font-weight:500}
.trust-stars{color:#f59e0b;letter-spacing:1px}

@media(max-width:900px){.left{display:none}}

/* ── RIGHT FORM ── */
.right{
  width:100%;max-width:480px;background:var(--white);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:48px 44px;border-left:1px solid var(--border);
  overflow-y:auto;
}
@media(max-width:900px){.right{max-width:100%;border-left:none;padding:36px 24px}}

.form-logo{display:flex;align-items:center;gap:8px;margin-bottom:28px;text-decoration:none}
.form-logo-icon{width:36px;height:36px;border-radius:9px;overflow:hidden;flex-shrink:0}
.form-logo-icon img{width:100%;height:100%;object-fit:cover;display:block}
.form-logo-name{font-size:19px;font-weight:800;color:var(--text);letter-spacing:-.3px}
.form-logo-name span{color:var(--p)}

h1{font-size:24px;font-weight:800;color:var(--text);margin-bottom:4px;text-align:center;letter-spacing:-.4px}
.sub{font-size:14px;color:var(--sub);text-align:center;margin-bottom:24px}

.google-btn{
  width:100%;display:flex;align-items:center;justify-content:center;gap:10px;
  background:var(--white);border:1.5px solid var(--border);border-radius:11px;
  padding:13px 16px;font-size:14px;font-weight:600;color:var(--text);
  cursor:pointer;transition:all .15s;margin-bottom:16px;
  box-shadow:0 1px 3px rgba(0,0,0,.05);font-family:inherit;
}
.google-btn:hover{border-color:var(--p);box-shadow:0 0 0 3px rgba(124,58,237,.08)}

.divider{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.divider hr{flex:1;border:none;border-top:1px solid var(--border)}
.divider span{font-size:12px;color:#94a3b8;white-space:nowrap}

.err{display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:10px 14px;border-radius:9px;margin-bottom:14px;font-size:13px}
.succ{display:none;background:#f0fdf4;border:1px solid #bbf7d0;color:#15803d;padding:10px 14px;border-radius:9px;margin-bottom:14px;font-size:13px;text-align:center;font-weight:600}

.field{margin-bottom:13px}
label{display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:5px}
.iw{position:relative}
.ii{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#9ca3af;pointer-events:none;display:flex}
input[type=email],input[type=password],input[type=text]{
  width:100%;padding:12px 16px 12px 42px;
  border:1.5px solid var(--border);border-radius:10px;
  font-size:14px;outline:none;color:var(--text);font-family:inherit;
  transition:border-color .15s,box-shadow .15s;background:var(--white);
}
input:focus{border-color:var(--p);box-shadow:0 0 0 3px rgba(124,58,237,.1)}
.eye{position:absolute;right:13px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#9ca3af;display:flex}
.pri{padding-right:44px}

.sbtn{
  width:100%;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;
  font-size:15px;font-weight:700;padding:14px;border:none;border-radius:11px;
  cursor:pointer;margin-top:6px;letter-spacing:.2px;font-family:inherit;
  box-shadow:0 4px 15px rgba(124,58,237,.35);transition:all .15s;
}
.sbtn:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(124,58,237,.4)}
.sbtn:disabled{opacity:.6;cursor:not-allowed;transform:none}

.ft{text-align:center;margin-top:18px;font-size:13px;color:var(--sub)}
.ft a{color:var(--p);font-weight:700;text-decoration:none}
.ft a:hover{text-decoration:underline}
.terms{font-size:11px;color:#9ca3af;text-align:center;margin-top:14px;line-height:1.5}
.terms a{color:var(--sub);text-decoration:underline}
</style>

<script type="module">
  import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.11.0/firebase-app.js';
  import { getAuth, createUserWithEmailAndPassword, updateProfile, signInWithPopup,
           GoogleAuthProvider, onAuthStateChanged, getAdditionalUserInfo }
    from 'https://www.gstatic.com/firebasejs/10.11.0/firebase-auth.js';


  const firebaseConfig = {
    apiKey: "AIzaSyAtL5I-BrnePMIeITDLsPqsvffdiPWcEb0",
    authDomain: "resumaker-9ad7f.firebaseapp.com",
    projectId: "resumaker-9ad7f",
    storageBucket: "resumaker-9ad7f.firebasestorage.app",
    messagingSenderId: "945024215083",
    appId: "1:945024215083:web:57c682be4e26c92546a26e",
    measurementId: "G-CZE0PBD2EP"
  };

  const app=initializeApp(firebaseConfig), auth=getAuth(app);

  function getRedirect(){
    try{
      const r=new URLSearchParams(location.search).get('redirect');
      if(r && r.startsWith('/') && !r.startsWith('//')) return r;
    }catch{}
    return '/dashboard';
  }
  const redirectTo = getRedirect();

  let signingUp = false;
  onAuthStateChanged(auth,u=>{ if(u && !signingUp) window.location.href=redirectTo; });

  // ── Username helpers ──
  function slugify(str){
    return str.toLowerCase().replace(/[^a-z0-9_]/g,'_').replace(/_+/g,'_').replace(/^_|_$/g,'').slice(0,18);
  }
  async function isUsernameTaken(username){
    try{
      const r = await fetch(`/api/check-username?username=${encodeURIComponent(username)}`);
      const j = await r.json();
      return !j.available;
    }catch{ return false; }
  }
  async function generateUniqueUsername(base){
    const slug = slugify(base) || 'user';
    if(slug.length >= 3 && !(await isUsernameTaken(slug))) return slug;
    // try with 4-digit suffix
    for(let i=0;i<8;i++){
      const candidate = slug.slice(0,15) + '_' + Math.floor(1000+Math.random()*9000);
      if(!(await isUsernameTaken(candidate))) return candidate;
    }
    return slug.slice(0,14) + '_' + Date.now().toString().slice(-4);
  }

  async function saveUserToFirestore(user, name, email, username) {
    try {
      const idToken = await user.getIdToken();
      const res = await fetch('/api/register-user', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + idToken },
        body: JSON.stringify({ name, email, username }),
      });
      if (!res.ok) console.warn('register-user failed:', await res.text());
    } catch(e){ console.warn('saveUserToFirestore:', e.message); }
  }

  // ── Live username availability check ──
  let _unTimer = null;
  window._signupUsernameOk = false;
  window.signupDebounceCheck = function(val){
    const el = document.getElementById('usernameStatus');
    window._signupUsernameOk = false;
    clearTimeout(_unTimer);
    if(!val){ el.textContent=''; return; }
    if(!/^[a-z0-9_]{3,20}$/.test(val)){
      el.style.color='#e11d48'; el.textContent='3–20 chars · letters, numbers, underscores only'; return;
    }
    el.style.color='#94a3b8'; el.textContent='Checking…';
    _unTimer = setTimeout(async()=>{
      try{
        const r = await fetch(`/api/check-username?username=${encodeURIComponent(val)}`);
        const j = await r.json();
        if(j.available){ el.style.color='#059669'; el.textContent='✓ Available'; window._signupUsernameOk=true; }
        else{ el.style.color='#e11d48'; el.textContent='✗ Already taken — choose another'; window._signupUsernameOk=false; }
      }catch{ el.style.color='#94a3b8'; el.textContent='Could not verify — will check on submit'; window._signupUsernameOk=true; }
    }, 500);
  };

  document.addEventListener('DOMContentLoaded',()=>{
    const err=document.getElementById('err'), succ=document.getElementById('succ'),
          btn=document.getElementById('sbtn'), pwd=document.getElementById('password'),
          conf=document.getElementById('conf');
    let show=false;

    // Username input live enforcement
    const unInput = document.getElementById('username');
    if(unInput){
      unInput.addEventListener('input',()=>{
        unInput.value = unInput.value.toLowerCase().replace(/[^a-z0-9_]/g,'');
        signupDebounceCheck(unInput.value);
      });
    }

    document.getElementById('googleBtn').onclick=async()=>{
      err.style.display='none';
      signingUp = true;
      try{
        const result = await signInWithPopup(auth, new GoogleAuthProvider());
        const info   = getAdditionalUserInfo(result);
        if (info?.isNewUser) {
          // Auto-generate a unique username from their Google display name
          const autoUsername = await generateUniqueUsername(result.user.displayName || result.user.email.split('@')[0]);
          await saveUserToFirestore(result.user, result.user.displayName||'', result.user.email||'', autoUsername);
          window.location.href='/onboarding';
        } else {
          window.location.href=redirectTo;
        }
      }
      catch(e){ err.textContent=fe(e.code); err.style.display='block'; signingUp=false; }
    };

    document.getElementById('eyeBtn').onclick=()=>{ show=!show; pwd.type=show?'text':'password'; conf.type=show?'text':'password'; };

    document.getElementById('form').onsubmit=async(e)=>{
      e.preventDefault(); err.style.display='none';
      const name=document.getElementById('name').value.trim(),
            email=document.getElementById('email').value.trim(),
            username=(document.getElementById('username').value||'').toLowerCase().trim(),
            pass=pwd.value, c=conf.value;
      if(pass!==c){ err.textContent='Passwords do not match.'; err.style.display='block'; return; }
      if(pass.length<6){ err.textContent='Password must be at least 6 characters.'; err.style.display='block'; return; }
      if(!username){ err.textContent='Please choose a username.'; err.style.display='block'; return; }
      if(!/^[a-z0-9_]{3,20}$/.test(username)){ err.textContent='Username must be 3–20 chars, letters/numbers/underscores only.'; err.style.display='block'; return; }
      // Final availability check before creating account
      const taken = await isUsernameTaken(username);
      if(taken){ err.textContent='That username is already taken. Choose another.'; err.style.display='block'; return; }
      btn.disabled=true; btn.textContent='Creating account…';
      signingUp = true;
      try{
        const cred=await createUserWithEmailAndPassword(auth,email,pass);
        await updateProfile(cred.user,{displayName:name});
        await saveUserToFirestore(cred.user, name, email, username);
        document.getElementById('form').style.display='none';
        succ.textContent='🎉 Account created! Setting up your profile…';
        succ.style.display='block';
        setTimeout(()=>window.location.href='/onboarding', 1400);
      }
      catch(e){ err.textContent=fe(e.code); err.style.display='block'; btn.disabled=false; btn.textContent='Create Free Account →'; signingUp=false; }
    };
  });

  function fe(c){
    return({
      'auth/email-already-in-use':'An account with that email already exists.',
      'auth/invalid-email':'Please enter a valid email address.',
      'auth/weak-password':'Password is too weak (min 6 chars).',
      'auth/popup-closed-by-user':'Popup closed. Try again.'
    })[c]||'Something went wrong. Please try again.';
  }
</script>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="/" class="logo">
    <div class="logo-icon"><img src="/logo.jpg" alt="Kievora"/></div>
    <span class="logo-name">Kie<span>vora</span></span>
  </a>
  <div class="nav-right">
    <a href="/login" class="btn-outline">Sign In</a>
  </div>
</nav>

<div class="page">

  <!-- LEFT BRAND PANEL -->
  <div class="left">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="left-inner">
      <div class="left-badge">
        <span class="left-badge-dot"></span>
        <span>Free forever · No credit card needed</span>
      </div>
      <h2>Build a resume that<br/><span>gets you hired.</span></h2>
      <p>Join thousands of job seekers who use Kievora to craft standout resumes and land their next role.</p>

      <ul class="features">
        <li>
          <div class="feat-check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          10 professional, ATS-friendly templates
        </li>
        <li>
          <div class="feat-check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          KIE AI coach — summaries, bullets, skills
        </li>
        <li>
          <div class="feat-check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          One-click PDF export, always free
        </li>
        <li>
          <div class="feat-check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          Resume Analyzer with ATS scoring
        </li>
        <li>
          <div class="feat-check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          Career Reads — expert articles & tips
        </li>
      </ul>

      <div class="trust">
        <span class="trust-stars">★★★★★</span>
        <span>Rated <strong>4.8</strong> by thousands of job seekers</span>
      </div>
    </div>
  </div>

  <!-- RIGHT FORM -->
  <div class="right">
    <a href="/" class="form-logo">
      <div class="form-logo-icon"><img src="/logo.jpg" alt="Kievora"/></div>
      <span class="form-logo-name">Kie<span>vora</span></span>
    </a>

    <h1>Create your free account</h1>
    <p class="sub">Already have an account? <a href="/login" style="color:var(--p);font-weight:700;text-decoration:none;">Sign in →</a></p>

    <button id="googleBtn" class="google-btn">
      <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.964 10.707A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.707V4.961H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.039l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.961L3.964 6.293C4.672 4.166 6.656 3.58 9 3.58z"/></svg>
      Continue with Google
    </button>

    <div class="divider"><hr/><span>or sign up with email</span><hr/></div>

    <div id="err" class="err"></div>
    <div id="succ" class="succ"></div>

    <form id="form" style="width:100%">
      <div class="field">
        <label for="name">Full name</label>
        <div class="iw">
          <span class="ii"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
          <input type="text" id="name" placeholder="Your full name" required autocomplete="name"/>
        </div>
      </div>
      <div class="field">
        <label for="username">Username</label>
        <div class="iw">
          <span class="ii" style="font-weight:700;font-size:14px;color:#94a3b8">@</span>
          <input type="text" id="username" placeholder="your_username" maxlength="20" required autocomplete="off" style="text-transform:lowercase"/>
        </div>
        <div id="usernameStatus" style="font-size:12px;margin-top:5px;font-weight:600;min-height:16px"></div>
        <small style="color:#94a3b8;font-size:11px;display:block;margin-top:2px">3–20 chars · letters, numbers, underscores only</small>
      </div>
      <div class="field">
        <label for="email">Email address</label>
        <div class="iw">
          <span class="ii"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
          <input type="email" id="email" placeholder="you@example.com" required autocomplete="email"/>
        </div>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <div class="iw">
          <span class="ii"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
          <input type="password" id="password" placeholder="Min. 6 characters" required autocomplete="new-password" class="pri"/>
          <button type="button" id="eyeBtn" class="eye"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
      </div>
      <div class="field">
        <label for="conf">Confirm password</label>
        <div class="iw">
          <span class="ii"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
          <input type="password" id="conf" placeholder="Re-enter password" required autocomplete="new-password" class="pri"/>
        </div>
      </div>
      <button id="sbtn" class="sbtn" type="submit">Create Free Account →</button>
    </form>

    <p class="ft">Already have an account? <a href="/login">Sign in here</a></p>
    <p class="terms">By signing up you agree to our <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.</p>
  </div>

</div>
</body>
</html>
